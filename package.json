{
  "name": "littletake",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "tsx server/app/service.ts",
    "dev": "vite --host 127.0.0.1 --port 4176 --strictPort",
    "jobs": "tsx server/reference/jobs/service.ts",
    "verify:jobs": "tsx --test server/reference/jobs/verify.ts",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1 --port 4176 --strictPort",
    "test": "tsx --test tests/*.test.ts src/**/*.test.ts server/**/*.test.ts"
  },
  "dependencies": {
    "@jitl/quickjs-wasmfile-release-sync": "0.32.0",
    "@meta-sam/parser": "0.1.0",
    "@resvg/resvg-js": "^2.6.2",
    "lucide": "1.66.0",
    "mediabunny": "1.62.1",
    "onnxruntime-web": "^1.31.1",
    "playwright-core": "1.64.1",
    "pngjs": "7.0.0",
    "quickjs-emscripten-core": "0.32.0",
    "three": "0.186.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "26.6.5",
    "@types/pngjs": "6.0.5",
    "@types/three": "0.186.0",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.5"
  },
  "engines": {
    "node": ">=24.0.0"
  }
}
