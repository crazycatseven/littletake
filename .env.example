# Server-side only. Never use a VITE_ prefix for credentials.
AI_PROVIDER=meta
MODEL_API_KEY=
# Reference-image segmentation defaults to Meta API; local requires prepared CUDA weights.
SAM_PROVIDER=cloud
MUSE_MODEL=muse-spark-1.3-contributor
MUSE_IMAGE_MODEL=muse-image-1.0
# Local depth. setup.bat vggt prepares files; run.bat enables the on-demand API.
# Startup does not load the GPU model; Agent depth requests do.
# VGGT-1B is for research. Commercial weights require access to VGGT-1B-Commercial.
VGGT_MODEL_REPO=facebook/VGGT-1B
VGGT_DEVICE=cuda
LOCAL_MODEL_MIN_FREE_VRAM_GB=16
# Optional fixed editor port. Otherwise 4176 is preferred and Vite finds a free port.
# LITTLETAKE_PORT=4176
# Optional persistent project directory. Defaults to .littletake in local development.
# LITTLETAKE_DATA_DIR=
# Optional comma-separated development hostnames, for example a private Tailscale DNS name.
# LITTLETAKE_ALLOWED_HOSTS=

# Optional paused background worker. The editor uses foreground browser rendering.
# REFERENCE_BACKEND_URL=http://127.0.0.1:4182
REFERENCE_BACKEND_KEY=
# Persistent service only. Mount this directory on a durable volume in production.
REFERENCE_DATA_DIR=.littletake/reference
REFERENCE_CALL_LIMIT=72

# Look-frame image model.
