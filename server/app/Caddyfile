{$LITTLETAKE_DOMAIN} {
    redir /demo/ /demo 308
    handle /demo {
        root * /data/public
        rewrite * /demo.html
        file_server
    }
    handle /demo.mp4 {
        root * /data/public
        file_server
    }
    handle {
        @compressible not path /api/scene-edit
        encode @compressible zstd gzip
        reverse_proxy app:8080
    }
    header Referrer-Policy same-origin
}
